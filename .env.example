# SC-MCP-SERVER environment configuration
# Copy to .env and adjust values for your deployment.

# ─── Workspace ──────────────────────────────────
# Path to the workspace root containing all SC-API-* folders
SC_WORKSPACE_ROOT=C:\Users\2786681\Downloads\SC-API-19-05-2026\SC -MCP-SERVER

# ─── Transport ──────────────────────────────────
# stdio = local AI client (Claude Desktop / Copilot)
# sse   = HTTP server (VM deployment, remote clients)
MCP_TRANSPORT=stdio

# HTTP transport settings (only used when MCP_TRANSPORT=sse)
# Set to 0.0.0.0 to accept connections from outside the VM
MCP_HOST=127.0.0.1
MCP_PORT=3100

# ─── Security ───────────────────────────────────
# REQUIRED for SSE mode. Set a strong API key to protect HTTP endpoints.
# Clients must send: Authorization: Bearer <this-key>
# Generate a key: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_API_KEY=

# ─── Safety — Mutation Guard ────────────────────
# Set to "true" to allow irreversible operations (confirm_booking creates real PNRs).
# Default "false" blocks confirm_booking to prevent accidental bookings.
ALLOW_MUTATIONS=false

# ─── APIM (Booking Agent Tools) ─────────────────
APIM_BASE_URL=https://nevioservicecenterapim.azure-api.net
APIM_TOKEN_TTL=1700

# ─── API Calling ────────────────────────────────
API_REQUEST_TIMEOUT=30

# ─── Cache ──────────────────────────────────────
CACHE_TTL=120
CACHE_MAX_SIZE=128

# ─── HTTPS / TLS ────────────────────────────────
# Set paths to SSL certificate and key for HTTPS (SSE mode).
# Leave empty to run plain HTTP (not recommended for production).
SSL_CERTFILE=
SSL_KEYFILE=

# ─── Rate Limiting ──────────────────────────────
# Max requests per IP per minute for HTTP endpoints.
RATE_LIMIT_PER_MINUTE=100

# ─── Logging ────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
