              "                    itemAdded = true;\r",
              "                }\r",
              "            }\r",
              "        }\r",
              "    }\r",
              "    \r",
              "    // If still nothing assigned, skip this passenger\r",
              "    if (!itemAdded) {\r",
              "        console.log(`✗ No seat or bundle available for passenger: ${passenger.passengerId}`);\r",
              "    }\r",
