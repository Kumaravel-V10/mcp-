            "exec": [
              "// Get environment variables\r",
              "const passengers = JSON.parse(pm.environment.get(\"passengers\") || \"[]\");\r",
              "const flightId = pm.environment.get(\"flightId\") || \"\";\r",
              "\r",
              "// Check if response is successful\r",
              "if (!pm.response.code === 200) {\r",
              "    console.log(\"Error: Response is not successful\");\r",
              "    return;\r",
              "}\r",
              "\r",
              "const responseData = pm.response.json();\r",
              "const seatmapData = responseData.data?.getSeatMap?.data;\r",
              "\r",
              "if (!seatmapData) {\r",
              "    console.log(\"Error: No seatmap data found in response\");\r",
              "    return;\r",
              "}\r",
              "\r",
              "const seatmaps = seatmapData.seatmaps || [];\r",
              "const services = seatmapData.services || {};\r",
              "\r",
              "// Track assigned seats and counts\r",
              "const assignedSeats = new Set();\r",
              "let bundleCount = 0;\r",
              "let seatCount = 0;\r",
              "const totalPassengers = passengers.length;\r",
              "const targetBundlePercentage = 0.35;\r",
              "const targetSeatPercentage = 0.65;\r",
              "\r",
              "// Helper function to get flightId from bundle's subServiceIds\r",
              "function getFlightIdFromBundle(bundleId) {\r",
              "    const bundle = services[bundleId];\r",
              "    if (!bundle || !bundle.packDetails || !bundle.packDetails.subServiceIds) {\r",
              "        return \"\";\r",
              "    }\r",
              "    const subService = bundle.packDetails.subServiceIds.find(sub => sub.flightIds && sub.flightIds.length > 0);\r",
              "    return subService ? subService.flightIds[0] : \"\";\r",
              "}\r",
              "\r",
              "// Function to find an available unique seat for a passenger (NO bundle)\r",
              "function findSeatForPassenger(passengerId) {\r",
              "    if (seatmaps.length === 0) return null;\r",
              "    \r",
              "    const deck = seatmaps[0].decks[0];\r",
              "    const seats = deck.seats || [];\r",
              "    \r",
              "    // Look for an available seat assigned to this passenger that hasn't been used yet\r",
              "    for (let seat of seats) {\r",
              "        // Skip if seat already assigned to another passenger\r",
              "        if (assignedSeats.has(seat.seatNumber)) {\r",
              "            continue;\r",
              "        }\r",
              "        \r",
              "        for (let traveler of seat.travelers) {\r",
              "            if (traveler.id === passengerId && \r",
              "                traveler.seatAvailabilityStatus === \"available\") {\r",
              "                assignedSeats.add(seat.seatNumber);\r",
              "                return {\r",
              "                    seatNumber: seat.seatNumber,\r",
              "                    flightId: flightId,\r",
              "                    seat: seat.seatNumber,\r",
              "                    bundleId: \"\"\r",
              "                };\r",
              "            }\r",
              "        }\r",
              "    }\r",
              "    \r",
              "    return null;\r",
              "}\r",
              "\r",
              "// ✅ FIXED: Function to find a bundle for a passenger using seat's packServiceIds\r",
              "function findBundleForPassenger(passengerId) {\r",
              "    if (seatmaps.length === 0) return null;\r",
              "    \r",
              "    const deck = seatmaps[0].decks[0];\r",
              "    const seats = deck.seats || [];\r",
              "    \r",
              "    // Find an available seat for this passenger that has packServiceIds (bundles)\r",
              "    for (let seat of seats) {\r",
              "        // Skip if seat already assigned to another passenger\r",
              "        if (assignedSeats.has(seat.seatNumber)) {\r",
              "            continue;\r",
              "        }\r",
              "        \r",
              "        for (let traveler of seat.travelers) {\r",
              "            if (traveler.id === passengerId && \r",
              "                traveler.seatAvailabilityStatus === \"available\") {\r",
              "                \r",
              "                // ✅ CORRECT: Get bundleId from seat's traveler packServiceIds\r",
              "                const packServiceIds = traveler.packServiceIds || [];\r",
              "                \r",
              "                if (packServiceIds.length > 0) {\r",
              "                    const bundleId = packServiceIds[0]; // Use first available bundle\r",
              "                    const bundleFlightId = getFlightIdFromBundle(bundleId);\r",
              "                    \r",
              "                    assignedSeats.add(seat.seatNumber);\r",
              "                    return {\r",
              "                        seatNumber: seat.seatNumber,\r",
              "                        flightId: bundleFlightId, // flightId from bundle's subServiceIds\r",
              "                        seat: seat.seatNumber,\r",
              "                        bundleId: bundleId\r",
              "                    };\r",
              "                }\r",
              "            }\r",
              "        }\r",
              "    }\r",
              "    \r",
              "    return null;\r",
              "}\r",
              "\r",
              "// Function to check if we can add a bundle\r",
              "function canAddBundle() {\r",
              "    const currentBundlePercentage = (bundleCount + 1) / totalPassengers;\r",
              "    return currentBundlePercentage <= targetBundlePercentage;\r",
              "}\r",
              "\r",
              "// Function to check if we can add a seat\r",
              "function canAddSeat() {\r",
              "    const currentSeatPercentage = (seatCount + 1) / totalPassengers;\r",
              "    return currentSeatPercentage <= targetSeatPercentage;\r",
              "}\r",
              "\r",
              "// Build the addSeats array\r",
              "const addSeatsArray = [];\r",
              "\r",
              "passengers.forEach(passenger => {\r",
              "    const passengerObj = {\r",
              "        id: passenger.passengerId,\r",
              "        seat: []\r",
              "    };\r",
              "    \r",
              "    // Determine priority based on current distribution\r",
              "    const currentBundlePercentage = bundleCount / totalPassengers;\r",
              "    const shouldPrioritizeBundle = currentBundlePercentage < targetBundlePercentage;\r",
              "    \r",
              "    let itemAdded = false;\r",
              "    \r",
              "    if (shouldPrioritizeBundle) {\r",
              "        // Try bundle first\r",
              "        if (canAddBundle()) {\r",
              "            const bundleInfo = findBundleForPassenger(passenger.passengerId);\r",
              "            if (bundleInfo) {\r",
              "                passengerObj.seat.push({\r",
              "                    flightId: bundleInfo.flightId,\r",
              "                    seat: bundleInfo.seat,\r",
              "                    bundleId: bundleInfo.bundleId\r",
              "                });\r",
              "                bundleCount++;\r",
              "                addSeatsArray.push(passengerObj);\r",
              "                console.log(`✓ Passenger ${passenger.passengerId} assigned BUNDLE: ${bundleInfo.bundleId} (Seat: ${bundleInfo.seat})`);\r",
              "                itemAdded = true;\r",
              "            }\r",
              "        }\r",
              "    } else {\r",
              "        // Try seat first\r",
              "        if (canAddSeat()) {\r",
              "            const seatInfo = findSeatForPassenger(passenger.passengerId);\r",
              "            if (seatInfo) {\r",
              "                passengerObj.seat.push({\r",
              "                    flightId: seatInfo.flightId,\r",
              "                    seat: seatInfo.seat,\r",
              "                    bundleId: seatInfo.bundleId\r",
              "                });\r",
              "                seatCount++;\r",
              "                addSeatsArray.push(passengerObj);\r",
              "                console.log(`✓ Passenger ${passenger.passengerId} assigned SEAT: ${seatInfo.seat}`);\r",
              "                itemAdded = true;\r",
              "            }\r",
              "        }\r",
              "    }\r",
              "    \r",
              "    // If first priority couldn't be assigned, try the other\r",
              "    if (!itemAdded) {\r",
              "        if (shouldPrioritizeBundle) {\r",
              "            // Bundle was priority but failed, try seat\r",
              "            if (canAddSeat()) {\r",
              "                const seatInfo = findSeatForPassenger(passenger.passengerId);\r",
              "                if (seatInfo) {\r",
              "                    passengerObj.seat.push({\r",
              "                        flightId: seatInfo.flightId,\r",
              "                        seat: seatInfo.seat,\r",
              "                        bundleId: seatInfo.bundleId\r",
              "                    });\r",
              "                    seatCount++;\r",
              "                    addSeatsArray.push(passengerObj);\r",
              "                    console.log(`✓ Passenger ${passenger.passengerId} assigned SEAT: ${seatInfo.seat} (fallback)`);\r",
              "                    itemAdded = true;\r",
              "                }\r",
              "            }\r",
              "        } else {\r",
              "            // Seat was priority but failed, try bundle\r",
              "            if (canAddBundle()) {\r",
              "                const bundleInfo = findBundleForPassenger(passenger.passengerId);\r",
              "                if (bundleInfo) {\r",
              "                    passengerObj.seat.push({\r",
              "                        flightId: bundleInfo.flightId,\r",
